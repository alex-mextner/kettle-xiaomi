 DEFAULT_TARGET_TEMP = 90
 DEFAULT_POLL_INTERVAL = 60
+# While the kettle is heating: poll every FAST_POLL_INTERVAL s (status + temperature only).
+FAST_POLL_INTERVAL = 5
+FAST_POLL_STATUSES = {1}  # PROP_STATUS 1 = heating
 MIN_TEMP = 40
