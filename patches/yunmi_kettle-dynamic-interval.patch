     CONF_POLL_INTERVAL,
     CONF_TOKEN,
     DEFAULT_POLL_INTERVAL,
+    FAST_POLL_INTERVAL,
+    FAST_POLL_STATUSES,
     DOMAIN,
     DURATION_UNIT_MIN,
     PROFILE_COUNT,
@@ -47,6 +49,7 @@
             hass, _LOGGER, name=f"{DOMAIN}_{self.address}",
             update_interval=timedelta(seconds=interval),
         )
+        self._idle_interval = timedelta(seconds=interval)
         self._client: BleakClient | None = None
         self._dev: YunmiKettle | None = None
 
@@ -67,7 +70,11 @@
     async def _async_update_data(self) -> dict:
         try:
             dev = await self._ensure_session()
-            res = await dev.subscribe_and_read()
+            # While heating only status + temperature are read (~1 s instead of ~6 s).
+            heating = (self.data or {}).get("status") in FAST_POLL_STATUSES
+            res = await dev.subscribe_and_read(
+                pairs=[PROP_STATUS, PROP_CURRENT_TEMP] if heating else None
+            )
             data: dict = dict(self.data or {})
             if PROP_CURRENT_TEMP in res:
                 data["current_temp"] = res[PROP_CURRENT_TEMP]
@@ -86,8 +93,14 @@
             active = data.get("active_profile", 0)
             if f"profile_temp_{active + 1}" in data:
                 data["profile_temp"] = data[f"profile_temp_{active + 1}"]
+            # Dynamic poll interval: fast while heating, the configured one otherwise.
+            self.update_interval = (
+                timedelta(seconds=FAST_POLL_INTERVAL)
+                if data.get("status") in FAST_POLL_STATUSES else self._idle_interval
+            )
             return data
         except Exception as err:  # noqa: BLE001
+            self.update_interval = self._idle_interval
             await self._drop()
             raise UpdateFailed(str(err)) from err
 
diff -r a/custom_components/yunmi_kettle/protocol.py b/custom_components/yunmi_kettle/protocol.py
